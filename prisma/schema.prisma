generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  username    String
  name        String?
  role        String   @default("owner")
  roleLabel   String   @default("Administrateur") @map("role_label")
  password    String
  active      Boolean  @default(true)
  paymentLink String?  @map("payment_link")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Compte {
  id                  String   @id @default(uuid())
  libelle             String
  email               String
  motDePasse          String   @map("mot_de_passe")
  dateOuverture       String   @map("date_ouverture")
  dateReabonnement    String   @map("date_reabonnement")
  coutRechargeMensuel Int      @default(6500) @map("cout_recharge_mensuel")
  capacitePlaces      Int      @default(15) @map("capacite_places")
  maxProfils          Int      @default(5) @map("max_profils")
  statut              String   @default("actif")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")

  profils Profil[]

  @@map("comptes")
}

model Profil {
  id        String   @id @default(uuid())
  nom       String
  codePin   String   @default("1234") @map("code_pin")
  statut    String   @default("ok")
  compteId  String   @map("compte_id")
  compte    Compte   @relation(fields: [compteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  abonnements Abonnement[]

  @@map("profils")
}

model Client {
  id        String   @id @default(uuid())
  nom       String
  telephone String
  ancienId  String?  @map("ancien_id")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  abonnements Abonnement[]

  @@map("clients")
}

model Abonnement {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profilId  String   @map("profil_id")
  profil    Profil   @relation(fields: [profilId], references: [id], onDelete: Cascade)
  dateDebut String   @map("date_debut")
  dateFin   String   @map("date_fin")
  tarif     Int      @default(1500)
  statut    String   @default("actif")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("abonnements")
}

model MouvementCaisse {
  id           String   @id @default(uuid())
  type         String
  beneficiaire String
  montant      Int
  date         String
  motif        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("mouvements_caisse")
}

model CaissePointage {
  id                  String   @id @default("caisse-singleton")
  dernierPointageReel Int      @default(0) @map("dernier_pointage_reel")
  dateDernierPointage String   @default("2026-10-22") @map("date_dernier_pointage")
  notes               String?

  @@map("caisse_pointage")
}

model AuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  userName  String   @map("user_name")
  action    String
  detail    String

  @@map("audit_logs")
}

model RelanceConfig {
  key   String @id
  value String

  @@map("settings")
}
